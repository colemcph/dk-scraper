# Server
PORT=3000
LOG_LEVEL=info

# DraftKings product to mirror. Ontario = dkcaon / ca-on. US examples: dkusoh/us-oh, dkusnj/us-nj, dkuswv/us-wv.
DK_SITE=dkcaon
DK_WS_REGION=ca-on
DK_LEAGUE_ID=88808
DK_LEAGUE_NAME=NFL
DK_SUBCATEGORY_ID=4518
# Point the app at a mock DraftKings (see scripts/chaos.ts). Leave unset for the real thing.
# DK_REST_BASE_URL=http://127.0.0.1:4801
# DK_WS_URL=ws://127.0.0.1:4802/websocket

# FanDuel (no push feed: page API for structure behind a 30 s CDN cache, plus the uncached live price channel their betslip polls)
FD_ENABLED=true               # set false to run DraftKings only
FD_REGION=on                  # Ontario. Their .com site refuses Canadian IPs (HTTP 400).
FD_PAGE_ID=nfl                # FanDuel's customPageId for the league (nba, mlb, nhl, ... exist too)
FD_LEAGUE_NAME=NFL
FD_TIMEZONE=America/Toronto
FD_POLL_INTERVAL_MS=1000      # fast cadence around the CDN copy's expiry; the adapter sleeps through max-age otherwise
FD_PRICE_INTERVAL_MS=5000     # cadence of the uncached live price channel (getMarketPrices); FanDuel's own client uses 5 s
FD_PRICES_ENABLED=true        # false = take prices from the cached page instead (bound goes back to ~31 s)
FD_CACHE_BYPASS=false         # true = unique query string per poll, every poll hits FanDuel's origin (~300 ms). Off by default.
# FD_API_KEY=FhMFpcPWXMeyZxOx # the public `_ak` FanDuel's own bundle sends; only override if they rotate it
# FD_REST_BASE_URL=http://127.0.0.1:4803   # mock FanDuel page (scripts/chaos.ts)
# FD_PRICE_BASE_URL=http://127.0.0.1:4803  # mock FanDuel price channel (scripts/chaos.ts)

# Feed behaviour (milliseconds)
RESYNC_INTERVAL_MS=60000      # periodic REST snapshot while the DraftKings socket is live (liveness proof + drift check)
POLL_INTERVAL_MS=3000         # DraftKings REST cadence when its socket is unavailable
WS_FALLBACK_AFTER_MS=15000    # how long to wait for the socket before falling back to polling
STALE_AFTER_MS=90000          # no successful contact with a book for this long => that book flagged stale
HEARTBEAT_INTERVAL_MS=10000   # SSE heartbeat cadence
REFRESH_MIN_INTERVAL_MS=5000  # per-book rate limit for the manual Refresh button
